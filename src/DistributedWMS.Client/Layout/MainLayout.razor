@inject JwtAuthStateProvider AuthProvider
@inject NavigationManager Navigation
@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">DistributedWMS</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-4">
                    @FullName(context.User) (@RoleName(context.User))
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit"
                               OnClick="LogoutAsync" title="Wyloguj" />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Elevation="1">
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                Pulpit
            </MudNavLink>
            <MudNavLink Href="products" Icon="@Icons.Material.Filled.Inventory2">
                Kartoteka towarów
            </MudNavLink>
            <MudNavLink Href="stock" Icon="@Icons.Material.Filled.Checklist">
                Stany magazynowe
            </MudNavLink>
            <MudNavLink Href="documents" Icon="@Icons.Material.Filled.Description">
                Dokumenty
            </MudNavLink>
            <AuthorizeView Roles="Manager,WarehouseOperator">
                <Authorized>
                    <MudNavLink Href="locations" Icon="@Icons.Material.Filled.Warehouse">
                        Lokalizacje
                    </MudNavLink>
                    <MudNavLink Href="shortages" Icon="@Icons.Material.Filled.Warning">
                        Raport braków
                    </MudNavLink>
                </Authorized>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private async Task LogoutAsync()
    {
        await AuthProvider.SignOutAsync();
        Navigation.NavigateTo("login", replace: true);
    }

    private static string RoleName(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole("Manager")) return "Kierownik";
        if (user.IsInRole("WarehouseOperator")) return "Magazynier";
        if (user.IsInRole("Technician")) return "Serwisant";
        return string.Empty;

    }

    private static string FullName(System.Security.Claims.ClaimsPrincipal user)
        => user.FindFirst("fullName")?.Value ?? user.Identity?.Name ?? string.Empty;
}