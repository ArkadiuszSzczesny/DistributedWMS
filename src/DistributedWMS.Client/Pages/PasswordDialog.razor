@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_password" Label="Nowe hasło"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      HelperText="Minimum 8 znaków" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Anuluj</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_saving || _password.Length < 8)" OnClick="SaveAsync">
               Ustaw hasło
           </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public UserDto User { get; set; } = null!;

    private string _password = string.Empty;
    private bool _saving;

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        _saving = true;

        try
        {
            var response = await Http.PutAsJsonAsync(
                $"api/users/{User.Id}/password", new ChangePasswordRequest(_password));

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Zmieniono hasło użytkownika {User.UserName}.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            var problem = await response.Content.ReadFromJsonAsync<ProblemResponse>();
            Snackbar.Add(problem?.Detail ?? "Nie udało się zmienić hasła.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd: {ex.Message}", Severity.Error);   
        }
        finally
        {
            _saving = false;
        }
    }
}