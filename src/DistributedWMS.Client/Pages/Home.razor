@page "/"
@attribute [Authorize]

<PageTitle>Pulpit</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Pulpit</MudText>

<MudGrid>
    <MudItem xs="12" md="4">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.subtitle1">Kartoteka towarów</MudText>
                <MudText Typo="Typo.body2" Class="mt-2">
                    Zarządzanie asortymentem i progami stanów minimalnych.
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="products" Variant="Variant.Text" Color="Color.Primary">
                    Przejdź
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.subtitle1">Stany magazynowe</MudText>
                <MudText Typo="Typo.body2" Class="mt-2">
                    Podgląd rozmieszczenia towarów w magazynie głównym i samochodach serwisowych.
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="stock" Variant="Variant.Text" Color="Color.Primary">
                    Przejdź
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.subtitle1">Raport braków</MudText>
                <MudText Typo="Typo.body2" Class="mt-2">
                    Towary o stanie łącznym poniżej progu minimalnego.
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Href="shortages" Variant="Variant.Text" Color="Color.Primary">
                    Przejdź
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>