@page "/documents"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Dokumenty</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-6">
    <MudText Typo="Typo.h4">Dokumenty magazynowe</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => Navigation.NavigateTo("documents/new"))">
           Nowy dokument
       </MudButton>
</MudStack>

<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <MudStack Row="true" Spacing="4">
        <MudSelect T="string" Label="Typ dokumentu" Value="_filterType"
                   ValueChanged="OnTypeChanged" Clearable="true" Variant="Variant.Outlined"
                   Dense="true" Style="max-width: 300px">
              <MudSelectItem T="string" Value="@("GoodsReceipt")">PZ - przyjęcie zewnętrzne</MudSelectItem>
              <MudSelectItem T="string" Value="@("StockTransfer")">MM - przesunięcie</MudSelectItem>
              <MudSelectItem T="string" Value="@("InternalIssue")">RW - rozchód wewnętrzny</MudSelectItem>
              <MudSelectItem T="string" Value="@("Inventory")">IN - inwentaryzacja</MudSelectItem>
        </MudSelect>

        <MudSelect T="string" Label="Status" Value="_filterStatus"
                   ValueChanged="OnStatusChanged" Clearable="true" Variant="Variant.Outlined"
                   Dense="true" Style="max-width: 250px">
              <MudSelectItem T="string" Value="@("Draft")">Roboczy</MudSelectItem>
              <MudSelectItem T="string" Value="@("Posted")">Zatwierdzony</MudSelectItem>
              <MudSelectItem T="string" Value="@("Cancelled")">Anulowany</MudSelectItem> 
        </MudSelect>
    </MudStack>
</MudPaper>

<MudTable Items="_documents" Loading="_loading" Hover="true" Striped="true" Dense="true"
          OnRowClick="OnRowClick" T="DocumentListItemDto" Class="cursor-pointer">
    <HeaderContent>
        <MudTh>Numer</MudTh>
        <MudTh>Typ</MudTh>
        <MudTh>Data</MudTh>
        <MudTh>Źródło</MudTh>
        <MudTh>Cel</MudTh>
        <MudTh>Wystawił</MudTh>
        <MudTh Style="text-align:center">Pozycji</MudTh>
        <MudTh>Status</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Numer"><strong>@context.Number</strong></MudTd>
        <MudTd DataLabel="Typ">@DocumentLabels.TypeName(context.Type)</MudTd>
        <MudTd DataLabel="Data">@context.DocumentDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
        <MudTd DataLabel="Źródło">@(context.SourceLocationCode ?? "-")</MudTd>
        <MudTd DataLabel="Cel">@(context.TargetLocationCode ?? "-")</MudTd>
        <MudTd DataLabel="Wystawił">@context.CreatedByUserName</MudTd>
        <MudTd DataLabel="Pozycji" Style="text-align:center">@context.LineCount</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">
                @DocumentLabels.StatusName(context.Status)
            </MudChip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>Brak dokumentów spełniających kryteria.</MudText>
    </NoRecordsContent>
</MudTable> 

@code {
    private IReadOnlyList<DocumentListItemDto> _documents = Array.Empty<DocumentListItemDto>();
    private bool _loading = true;
    private string? _filterType;
    private string? _filterStatus;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            var query = new List<string>();

            if (!string.IsNullOrWhiteSpace(_filterType))
                query.Add($"type={_filterType}");

            if (!string.IsNullOrWhiteSpace(_filterStatus))
                query.Add($"status={_filterStatus}");

            var url = "api/documents";
            if (query.Count > 0)
                url += "?" + string.Join("&", query);

            _documents = await Http.GetFromJsonAsync<List<DocumentListItemDto>>(url)
                         ?? new List<DocumentListItemDto>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nie udało się pobrać dokumentów: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnTypeChanged(string? value)
    {
        _filterType = value;
        await LoadAsync();
    }

    private async Task OnStatusChanged(string? value)
    {
        _filterStatus = value;
        await LoadAsync();
    }

    private void OnRowClick(TableRowClickEventArgs<DocumentListItemDto> args)
    {
        if (args.Item is not null)
            Navigation.NavigateTo($"documents/{args.Item.Id}");
    }

    private static Color StatusColor(string status) => status switch
    {
        "Draft" => Color.Warning,
        "Posted" => Color.Success,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };

}